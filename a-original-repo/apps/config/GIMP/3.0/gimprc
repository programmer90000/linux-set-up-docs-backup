(temp-path "/tmp/GIMP/")
(swap-compression "best")
(tile-cache-size 2g)
(use-opencl no)
(undo-levels 150)
(undo-size 1G)
(undo-preview-size small)
(plug-in-history-size 10)
(action-history-size 100)
(layer-previews no)
(group-layer-previews no)
(layer-preview-size medium)
(thumbnail-size normal)
(thumbnail-filesize-limit 8M)
(transparency-size large-checks)
(transparency-type gray-checks)
(snap-distance 8)
(marching-ants-speed 300)
(resize-windows-on-zoom no)
(resize-windows-on-resize no)
(default-show-all yes)
(default-dot-for-dot no)
(initial-zoom-to-fit yes)
(cursor-mode tool-icon)
(cursor-updating no)
(show-brush-outline yes)
(snap-brush-outline no)
(show-paint-tool-cursor yes)
(image-title-format "%F (%B)")
(image-status-format "%F (%B)")
(monitor-xresolution 0)
(monitor-yresolution 0)
(monitor-resolution-from-windowing-system yes)
(navigation-preview-size medium)
(activate-on-focus no)
(space-bar-action none)
(zoom-quality low)
(use-event-history yes)
(save-document-history yes)
(last-opened-size 10)
(import-promote-float no)
(import-promote-dither no)
(import-add-alpha yes)
(export-file-type png)
(export-color-profile no)
(export-comment no)
(export-thumbnail yes)
(export-metadata-exif no)
(export-metadata-xmp no)
(export-metadata-iptc no)
(edit-non-visible yes)
(move-tool-changes-active no)
(filter-tool-max-recent 10)
(filter-tool-use-last-settings no)
(trust-dirty-flag no)
(save-device-status yes)
(devices-share-tool yes)
(save-tool-options yes)
(can-change-accels no)
(save-accels yes)
(restore-accels yes)
(max-new-image-size 128M)
(toolbox-color-area yes)
(toolbox-foo-area yes)
(toolbox-image-area yes)
(toolbox-wilber no)
(toolbox-groups no)
(save-session-info yes)
(restore-session yes)
(restore-monitor yes)
(check-updates no)
(theme "Default")
(prefer-dark-theme yes)
(icon-theme "")
(prefer-symbolic-icons yes)
(dock-window-hint utility)
(cursor-handedness right)
(use-help yes)
(show-help-button yes)
(help-locales "en")
(help-browser gimp)
(user-manual-online no)
(default-image
    (width 1920)
    (height 1080)
    (unit pixels)
    (xresolution 300)
    (yresolution 300)
    (resolution-unit mm)
    (image-type rgb)
    (precision u8-non-linear)
    (color-profile NULL)
    (fill-type background)
    (comment "Created with GIMP"))
(default-grid
    (style solid)
    (fgcolor (color-rgba 0 0 0 1))
    (bgcolor (color-rgba 1 1 1 1))
    (xspacing 10)
    (yspacing 10)
    (spacing-unit pixels)
    (xoffset 0)
    (yoffset 0)
    (offset-unit pixels))
(default-view
    (show-menubar yes)
    (show-statusbar yes)
    (show-rulers yes)
    (show-scrollbars yes)
    (show-selection yes)
    (show-layer-boundary yes)
    (show-canvas-boundary yes)
    (show-guides yes)
    (show-grid yes)
    (show-sample-points yes)
    (snap-to-guides no)
    (snap-to-grid no)
    (snap-to-canvas no)
    (snap-to-path no)
    (padding-mode default)
    (padding-color (color-rgb 1 1 1))
    (padding-in-show-all no))
(default-fullscreen-view
    (show-menubar yes)
    (show-statusbar yes)
    (show-rulers yes)
    (show-scrollbars yes)
    (show-selection yes)
    (show-layer-boundary yes)
    (show-canvas-boundary yes)
    (show-guides yes)
    (show-grid yes)
    (show-sample-points yes)
    (snap-to-guides no)
    (snap-to-grid no)
    (snap-to-canvas no)
    (snap-to-path no)
    (padding-mode default)
    (padding-color (color-rgb 1 1 1))
    (padding-in-show-all no))
(color-management
    (mode display)
    (display-profile-from-gdk no)
    (display-rendering-intent relative-colorimetric)
    (display-use-black-point-compensation yes)
    (display-optimize yes)
    (simulation-rendering-intent perceptual)
    (simulation-use-black-point-compensation no)
    (simulation-optimize yes)
    (simulation-gamut-check no)
    (out-of-gamut-color (color-rgb 1 0 1)))
(fill-options
    (style solid)
    (antialias no)
    (feather no)
    (feather-radius 10))
(stroke-options
    (style solid)
    (antialias no)
    (feather no)
    (feather-radius 10)
    (method pencil)
    (width 6)
    (unit pixels)
    (cap-style butt)
    (join-style miter)
    (miter-limit 10)
    (dash-offset 0)
    (dash-info 0)
    (emulate-brush-dynamics no))